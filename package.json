{
  "name": "kyoto-ts",
  "private": true,
  "description": "TypeScript workspace for Quarto Rust monorepo",
  "workspaces": [
    "ts-packages/*",
    "hub-client",
    "trace-viewer",
    "q2-preview-spa",
    "q2-demos/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "@revealjs/react": "0.2.0",
    "@types/babel__standalone": "^7.1.9",
    "@types/katex": "^0.16.8",
    "@types/morphdom": "^2.3.0",
    "html2canvas": "^1.4.1",
    "katex": "0.17.0",
    "morphdom": "^2.7.8",
    "reveal.js": "6.0.0",
    "reveal.js-menu": "^2.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "at-least-node": "^1.0.0",
    "fake-indexeddb": "^6.2.5"
  }
}
