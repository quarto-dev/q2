
# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Byte-offset fixtures: the annotated-qmd example JSONs record byte offsets
# into these .qmd sources (and their line_breaks), so a CRLF checkout would
# shift every offset. Pin the whole directory, not just the .qmd sources: the
# JSON fixtures are single-line today, but the guard byte-compares them, so a
# future multi-line writer would break on Windows in exactly the way this pin
# exists to prevent (bd-1d6io).
ts-packages/annotated-qmd/examples/* text eol=lf

# pandoc-wasm (R0): constants, recordings, schemas, filters and fixtures are
# compared byte-for-byte or hashed, so a CRLF checkout would break them.
resources/pandoc-wasm.json text eol=lf
resources/pandoc-filters/** text eol=lf

# pandoc-wasm recordings: argv/env/params/input JSON, share tree and outputs are
# hashed or byte-compared. Text types are pinned to LF by extension; the
# binary outputs and images stay binary.
scripts/pandoc-capture.sh text eol=lf
crates/quarto-core/tests/fixtures/pandoc-recordings/**/*.json text eol=lf
crates/quarto-core/tests/fixtures/pandoc-recordings/**/*.qmd text eol=lf
crates/quarto-core/tests/fixtures/pandoc-recordings/**/*.bib text eol=lf
crates/quarto-core/tests/fixtures/pandoc-recordings/**/*.typ text eol=lf
crates/quarto-core/tests/fixtures/pandoc-recordings/**/*.html text eol=lf
