# extension; the binaries stay binary. Guarded by
# crates/quarto-core/tests/integration/fixture_line_endings.rs.
crates/quarto-core/tests/fixtures/pandoc-goldens/**/*.qmd text eol=lf
crates/quarto-core/tests/fixtures/pandoc-goldens/**/*.md text eol=lf
