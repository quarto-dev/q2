
# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Byte-offset fixtures: the annotated-qmd example and test-fixture JSONs record
# byte offsets into their sibling .qmd sources (and their line_breaks), so a
# CRLF checkout would shift every offset. Pin the whole directories, not just
# the .qmd sources: the JSON fixtures are single-line today, but the guard
# byte-compares them, so a future multi-line writer would break on Windows in
# exactly the way this pin exists to prevent (bd-1d6io, GH #1343).
ts-packages/annotated-qmd/examples/* text eol=lf
ts-packages/annotated-qmd/test/fixtures/* text eol=lf

# pandoc-wasm (R0): constants, recordings, schemas, filters and fixtures are
# compared byte-for-byte or hashed, so a CRLF checkout would break them.
resources/pandoc-wasm.json text eol=lf
resources/typst-wasm.json text eol=lf
resources/pandoc-filters/** text eol=lf
crates/quarto-core/schemas/pandoc-request.* text eol=lf

