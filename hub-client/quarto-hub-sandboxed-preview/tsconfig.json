{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Mirror the vite aliases (see vite.config.ts) for editor/tsc use */
    "paths": {
      "@quarto/preview-renderer": ["../../ts-packages/preview-renderer/src"],
      "@quarto/preview-renderer/*": ["../../ts-packages/preview-renderer/src/*"],
      "@quarto/preview-runtime": ["./src/stubs/preview-runtime.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
