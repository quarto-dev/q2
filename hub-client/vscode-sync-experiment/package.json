{
  "name": "quarto-hub-vscode",
  "displayName": "Quarto Hub",
  "description": "Open a Quarto Hub Automerge document as a live-synced text buffer with remote cursors",
  "version": "0.0.1",
  "private": true,
  "publisher": "posit",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:quartoHub.connect",
    "onCommand:quartoHub.disconnect",
    "onCommand:quartoHub.createFolder",
    "onFileSystem:quartohub",
    "workspaceContains:.quarto-hub/project.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "quartoHub.connect",
        "title": "Quarto Hub: Connect to Document"
      },
      {
        "command": "quartoHub.disconnect",
        "title": "Quarto Hub: Disconnect"
      },
      {
        "command": "quartoHub.createFolder",
        "title": "Quarto Hub: Create Folder from Project"
      }
    ],
    "configuration": {
      "title": "Quarto Hub",
      "properties": {
        "quartoHub.userName": {
          "type": "string",
          "default": "",
          "description": "Display name shown next to your cursor in Quarto Hub. Empty picks a name from your machine's username."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies",
    "clean": "rm -rf dist *.vsix"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-repo": "2.6.0-alpha.5",
    "@automerge/automerge-repo-network-websocket": "2.6.0-alpha.5",
    "@quarto/quarto-automerge-schema": "*",
    "@automerge/automerge-repo-storage-nodefs": "2.6.0-alpha.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3"
  }
}
