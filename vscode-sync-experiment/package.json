{
  "name": "quarto-hub-vscode",
  "displayName": "Quarto Hub",
  "description": "Open a Quarto Hub Automerge document as a live-synced text buffer with remote cursors",
  "version": "0.0.1",
  "private": true,
  "publisher": "posit",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:quartoHub.connect",
    "onCommand:quartoHub.disconnect",
    "onCommand:quartoHub.createFolder",
    "onCommand:quartoHub.attachFolder",
    "onCommand:quartoHub.rebindFolder",
    "onFileSystem:quartohub",
    "workspaceContains:.quarto-hub/project.json",
    "onCommand:quartoHub.shareFolder",
    "onCommand:quartoHub.showShare",
    "onCommand:quartoHub.joinSession",
    "onCommand:quartoHub.leaveSession"
  ],
  "contributes": {
    "commands": [
      {
        "command": "quartoHub.connect",
        "title": "Quarto Hub: Connect to Document"
      },
      {
        "command": "quartoHub.disconnect",
        "title": "Quarto Hub: Disconnect"
      },
      {
        "command": "quartoHub.createFolder",
        "title": "Quarto Hub: Create Folder from Project"
      },
      {
        "command": "quartoHub.attachFolder",
        "title": "Quarto Hub: Attach Folder to Project"
      },
      {
        "command": "quartoHub.rebindFolder",
        "title": "Quarto Hub: Rebind Folder to Project"
      },
      {
        "command": "quartoHub.detachedFiles",
        "title": "Quarto Hub: Detached Files"
      },
      {
        "command": "quartoHub.shareFolder",
        "title": "Quarto Hub: Share this folder"
      },
      {
        "command": "quartoHub.showShare",
        "title": "Quarto Hub: Show share information"
      },
      {
        "command": "quartoHub.joinSession",
        "title": "Quarto Hub: Join Session"
      },
      {
        "command": "quartoHub.leaveSession",
        "title": "Quarto Hub: Leave Session"
      }
    ],
    "configuration": {
      "title": "Quarto Hub",
      "properties": {
        "quartoHub.userName": {
          "type": "string",
          "default": "",
          "description": "Display name shown next to your cursor in Quarto Hub. Empty picks a name from your machine's username."
        },
        "quartoHub.q2Path": {
          "type": "string",
          "default": "q2",
          "scope": "machine",
          "markdownDescription": "The `q2` executable that Join Session runs for a share ticket. Found on `PATH` by default. Machine scope: a workspace `settings.json` cannot set it."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p demo",
    "package": "npx @vscode/vsce package --no-dependencies",
    "clean": "rm -rf dist *.vsix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:cross": "node e2e/run.mjs --cross",
    "test:e2e:timing": "node e2e/run.mjs --timing",
    "demo": "node demo/launch.mjs",
    "demo:all": "node demo/run-all.mjs",
    "demo:style-loop": "node demo/style-loop.mjs",
    "test:demo": "node demo/run-tests.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@automerge/automerge-repo": "2.6.0-alpha.5",
    "@automerge/automerge-repo-network-websocket": "2.6.0-alpha.5",
    "@automerge/automerge-repo-storage-nodefs": "2.6.0-alpha.5",
    "@quarto/quarto-automerge-schema": "*",
    "@quarto/quarto-git-epochs": "*",
    "@quarto/share-url": "*",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "node-pty": "1.1.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.17",
    "@types/ws": "^8.18.1"
  }
}
