body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "C08 Tabset Multi"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
      div.bslib-card.card.html-fill-container.tabset [data-bslib-card-init= data-full-screen=false]
        div.bslib-navs-card-title.card-header.dashboard-card-no-title
          ul.card-header-tabs.nav.nav-tabs [data-tabsetid=card-tabset-1 role=tablist]
            li.nav-item [role=presentation]
              a.active.nav-link [aria-selected=true data-bs-toggle=tab data-value=Plots href=#card-tabset-1-1 role=tab] "Plots"
            li.nav-item [role=presentation]
              a.nav-link [aria-selected=false data-bs-toggle=tab data-value=Data href=#card-tabset-1-2 role=tab] "Data"
        div.html-fill-container.html-fill-item.tab-content [data-tabset-id=card-tabset-1]
          div#card-tabset-1-1.active.html-fill-container.html-fill-item.show.tab-pane [role=tabpanel]
            div.card-body.html-fill-container.html-fill-item
              div.bslib-grid.html-fill-container.html-fill-item [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
                div.bslib-card.card.cell.html-fill-container.html-fill-item [data-bslib-card-init= data-full-screen=false]
                  div.card-header
                    div.card-title "C08-P1"
                  div.card-body.html-fill-container.html-fill-item
                    div.cell-output-display.html-fill-container.html-fill-item
                      img.img-fluid.quarto-dashboard-img-contain
                  bslib-tooltip
                    span.badge.bslib-full-screen-enter.rounded-pill
                div.bslib-card.card.cell.html-fill-container.html-fill-item [data-bslib-card-init= data-full-screen=false]
                  div.card-header
                    div.card-title "C08-P2"
                  div.card-body.html-fill-container.html-fill-item
                    div.cell-output-display.html-fill-container.html-fill-item
                      img.img-fluid.quarto-dashboard-img-contain
                  bslib-tooltip
                    span.badge.bslib-full-screen-enter.rounded-pill
          div#card-tabset-1-2.html-fill-container.html-fill-item.tab-pane [role=tabpanel]
            div.card-body.html-fill-container.html-fill-item
              div.bslib-grid.html-fill-container.html-fill-item [style=display: grid; grid-template-columns: minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
                div.bslib-card.card.cell.html-fill-container.html-fill-item [data-bslib-card-init= data-full-screen=false]
                  div.card-header
                    div.card-title "C08-D1"
                  div.card-body.html-fill-container.html-fill-item
                    div.cell-output-display.html-fill-container.html-fill-item
                      img.img-fluid.quarto-dashboard-img-contain
                  bslib-tooltip
                    span.badge.bslib-full-screen-enter.rounded-pill
                div#<uuid>.hidden.html-fill-container.html-fill-item
        bslib-tooltip
          span.badge.bslib-full-screen-enter.rounded-pill
