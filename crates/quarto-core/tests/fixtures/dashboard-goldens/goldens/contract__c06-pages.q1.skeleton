body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "C06 Pages"
        div#dashboard-collapse.collapse.navbar-collapse
          ul.me-auto.navbar-nav.navbar-nav-scroll [role=tablist]
            li.nav-item [role=presentation]
              a#tab-bills.active.nav-link [aria-controls=bills aria-selected=true data-bs-target=#bills data-bs-toggle=tab data-scrolling=false href=#bills role=tab]
                span.nav-link-text "Bills"
            li.nav-item [role=presentation]
              a#tab-flippers.nav-link [aria-controls=flippers aria-selected=false data-bs-target=#flippers data-bs-toggle=tab data-scrolling=true href=#flippers role=tab]
                span.nav-link-text "Flippers"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content.quarto-dashboard-pages [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item.tab-content [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
      div#bills.active.dashboard-page.html-fill-container.html-fill-item.show.tab-pane [aria-labelledby=tab-bills]
        div.bslib-grid.html-fill-container.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
          div.bslib-card.card.cell.html-fill-container.html-fill-item [data-bslib-card-init= data-full-screen=false]
            div.card-header
              div.card-title "C06-BILLS"
            div.card-body.html-fill-container.html-fill-item
              div.cell-output-display.html-fill-container.html-fill-item
                img.img-fluid.quarto-dashboard-img-contain
            bslib-tooltip
              span.badge.bslib-full-screen-enter.rounded-pill
      div#flippers.dashboard-page.grid-skip.html-fill-container.html-fill-item.tab-pane [aria-labelledby=tab-flippers data-scrolling=true]
        div.bslib-grid.html-fill-container.html-fill-item [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
          div.bslib-grid.html-fill-container.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
            div.bslib-card.card.cell.html-fill-container.html-fill-item [data-bslib-card-init= data-full-screen=false]
              div.card-header
                div.card-title "C06-F1"
              div.card-body.html-fill-container.html-fill-item
                div.cell-output-display.html-fill-container.html-fill-item
                  img.img-fluid.quarto-dashboard-img-contain
              bslib-tooltip
                span.badge.bslib-full-screen-enter.rounded-pill
            div.bslib-card.card.cell.html-fill-container.html-fill-item [data-bslib-card-init= data-full-screen=false]
              div.card-header
                div.card-title "C06-F2"
              div.card-body.html-fill-container.html-fill-item
                div.cell-output-display.html-fill-container.html-fill-item
                  img.img-fluid.quarto-dashboard-img-contain
              bslib-tooltip
                span.badge.bslib-full-screen-enter.rounded-pill
          div.bslib-grid.html-fill-container.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
            div.bslib-card.card.cell.html-fill-container.html-fill-item [data-bslib-card-init= data-full-screen=false]
              div.card-header
                div.card-title "C06-F3"
              div.card-body.html-fill-container.html-fill-item
                div.cell-output-display.html-fill-container.html-fill-item
                  img.img-fluid.quarto-dashboard-img-contain
              bslib-tooltip
                span.badge.bslib-full-screen-enter.rounded-pill
