body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "ValueBoxes"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, max-content) minmax(3em, max-content) minmax(3em, max-content) minmax(3em, max-content); grid-auto-columns: minmax(0, 1fr);]
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bslib-card.card.html-fill-container [data-bslib-card-init= data-full-screen=false]
          div.card-body.html-fill-container.html-fill-item
            div.align-content-center.callout-header.d-flex.html-fill-container.html-fill-item
              div.callout-icon-container.html-fill-container.html-fill-item
              div.callout-title-container.flex-fill.html-fill-container.html-fill-item
            div.callout-body.callout-body-container.html-fill-container.html-fill-item
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bg-primary.bslib-card.bslib-value-box.card.cell.html-fill-container.showcase-left-center.valuebox [data-bslib-card-init=]
          div.card-body.html-fill-container.html-fill-item
            div.html-fill-container.html-fill-item.value-box-grid
              div.html-fill-container.html-fill-item.value-box-showcase
              div.value-box-area
                p.value-box-title "Are Things Good?"
                p.value-box-value "192"
        div.bg-primary.bslib-card.bslib-value-box.card.cell.html-fill-container.showcase-left-center.valuebox [data-bslib-card-init=]
          div.card-body.html-fill-container.html-fill-item
            div.html-fill-container.html-fill-item.value-box-grid
              div.html-fill-container.html-fill-item.value-box-showcase
              div.value-box-area
                p.value-box-title "Really? Are They Good?"
                p.value-box-value "137"
        div.bg-secondary.bslib-card.bslib-value-box.card.cell.html-fill-container.showcase-left-center.valuebox [data-bslib-card-init=]
          div.card-body.html-fill-container.html-fill-item
            div.html-fill-container.html-fill-item.value-box-grid
              div.html-fill-container.html-fill-item.value-box-showcase
              div.value-box-area
                p.value-box-title "Cool things"
                p.value-box-value "135"
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bg-secondary.bslib-card.bslib-value-box.card.html-fill-container.showcase-bottom.valuebox [data-bslib-card-init=]
          div.card-body.html-fill-container.html-fill-item
            div.html-fill-container.html-fill-item.value-box-grid
              div.html-fill-container.html-fill-item.value-box-showcase
              div.value-box-area
                p.value-box-value "142"
        div.bg-secondary.bslib-card.bslib-value-box.card.html-fill-container.showcase-left-center.valuebox [data-bslib-card-init=]
          div.card-body.html-fill-container.html-fill-item
            div.html-fill-container.html-fill-item.value-box-grid
              div.html-fill-container.html-fill-item.value-box-showcase
              div.value-box-area
                p.value-box-value "3"
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bg-secondary.bslib-card.bslib-value-box.card.html-fill-container.showcase-left-center.valuebox [data-bslib-card-init=]
          div.card-body.html-fill-container.html-fill-item
            div.html-fill-container.html-fill-item.value-box-grid
              div.html-fill-container.html-fill-item.value-box-showcase
              div.value-box-area
                p.value-box-title "Number of Times Cats Kick Ass"
                p.value-box-value "7"
        div.bg-secondary.bslib-card.bslib-value-box.card.html-fill-container.showcase-top-right.valuebox [data-bslib-card-init=]
          div.card-body.html-fill-container.html-fill-item
            div.html-fill-container.html-fill-item.value-box-grid
              div.html-fill-container.html-fill-item.value-box-showcase
              div.value-box-area
                p.value-box-value "398"
