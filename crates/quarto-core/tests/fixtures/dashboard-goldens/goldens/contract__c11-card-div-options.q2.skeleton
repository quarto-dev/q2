body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "C11 Card Options"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr) minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bslib-card.card.html-fill-container [data-bslib-card-init= data-full-screen=false style=height: 200px;]
          div.card-header
            div.card-title "C11-PADDED"
          div.card-body.html-fill-container.html-fill-item [style=padding: 0px;]
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
        div.bslib-card.card.html-fill-container [data-bslib-card-init= data-full-screen=false style=max-height: 300px; min-height: 100px;]
          div.card-header
            div.card-title "C11-MINMAX"
          div.card-body.html-fill-container.html-fill-item
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
        div.bslib-card.card.html-fill-container [data-bslib-card-init=]
          div.card-header
            div.card-title "C11-NOEXPAND"
          div.card-body.html-fill-container.html-fill-item
        div.bslib-card.card.html-fill-container [data-bslib-card-init= data-full-screen=false]
          div.card-header
            div.card-title "C11-NOFILL"
          div.card-body.html-fill-container.html-fill-item
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
