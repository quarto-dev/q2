body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "No Headers"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr) minmax(3em, max-content); grid-auto-columns: minmax(0, 1fr);]
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bslib-card.card.html-fill-container [data-bslib-card-init= data-full-screen=false]
          div.card-body.html-fill-container.html-fill-item
          div.card-body.cell.html-fill-container.html-fill-item
            div.cell-output-display.html-fill-container.html-fill-item
              div#fig-cars.html-fill-container.html-fill-item.quarto-figure.quarto-figure-center.quarto-float
                figure.figure.html-fill-container.html-fill-item.quarto-float.quarto-float-fig
                  div.html-fill-container.html-fill-item
                    img.figure-img.img-fluid.quarto-dashboard-img-contain
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
        div.bslib-card.card.html-fill-container [data-bslib-card-init= data-full-screen=false]
          div.card-body.html-fill-container.html-fill-item
          div.card-body.cell.html-fill-container.html-fill-item
            div.cell-output-display.html-fill-container.html-fill-item
              div#fig-cars2.html-fill-container.html-fill-item.quarto-figure.quarto-figure-center.quarto-float
                figure.figure.html-fill-container.html-fill-item.quarto-float.quarto-float-fig
                  div.html-fill-container.html-fill-item
                    img.figure-img.img-fluid.quarto-dashboard-img-contain
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bg-secondary.bslib-card.bslib-value-box.card.html-fill-container.showcase-left-center.valuebox [data-bslib-card-init=]
          div.card-body.html-fill-container.html-fill-item
            div.html-fill-container.html-fill-item.value-box-grid
              div.html-fill-container.html-fill-item.value-box-showcase
              div.value-box-area
                p.value-box-value "0"
        div.bg-secondary.bslib-card.bslib-value-box.card.html-fill-container.showcase-left-center.valuebox [data-bslib-card-init=]
          div.card-body.html-fill-container.html-fill-item
            div.html-fill-container.html-fill-item.value-box-grid
              div.html-fill-container.html-fill-item.value-box-showcase
              div.value-box-area
                p.value-box-value "1,524"
        div.bg-secondary.bslib-card.bslib-value-box.card.html-fill-container.showcase-left-center.valuebox [data-bslib-card-init=]
          div.card-body.html-fill-container.html-fill-item
            div.html-fill-container.html-fill-item.value-box-grid
              div.html-fill-container.html-fill-item.value-box-showcase
              div.value-box-area
                p.value-box-value "0.27%."
