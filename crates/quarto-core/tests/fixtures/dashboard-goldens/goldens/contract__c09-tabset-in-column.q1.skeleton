body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "C09 Tabset Column"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 60fr) minmax(3em, 40fr); grid-auto-columns: minmax(0, 1fr);]
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bslib-card.card.cell.html-fill-container [data-bslib-card-init= data-full-screen=false]
          div.card-header
            div.card-title "C09-TOP"
          div.card-body.html-fill-container.html-fill-item
            div.cell-output-display.html-fill-container.html-fill-item
              img.img-fluid.quarto-dashboard-img-contain
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bslib-card.card.html-fill-container.tabset [data-bslib-card-init= data-full-screen=false]
          div.bslib-navs-card-title.card-header.dashboard-card-no-title
            ul.card-header-tabs.nav.nav-tabs [data-tabsetid=card-tabset-2 role=tablist]
              li.nav-item [role=presentation]
                a.active.nav-link [aria-selected=true data-bs-toggle=tab data-value=C09-TAB-A href=#card-tabset-2-1 role=tab] "C09-TAB-A"
              li.nav-item [role=presentation]
                a.nav-link [aria-selected=false data-bs-toggle=tab data-value=C09-TAB-B href=#card-tabset-2-2 role=tab] "C09-TAB-B"
          div.html-fill-container.html-fill-item.tab-content [data-tabset-id=card-tabset-2]
            div#card-tabset-2-1.active.html-fill-container.html-fill-item.show.tab-pane [role=tabpanel]
              div.card-body.html-fill-container.html-fill-item
                div.cell-output-display.html-fill-container.html-fill-item
                  img.img-fluid.quarto-dashboard-img-contain
            div#card-tabset-2-2.html-fill-container.html-fill-item.tab-pane [role=tabpanel]
              div.card-body.html-fill-container.html-fill-item
                div.cell-output-display.html-fill-container.html-fill-item
                  img.img-fluid.quarto-dashboard-img-contain
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
        div.bslib-grid [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
          div.bslib-card.card.cell.html-fill-container [data-bslib-card-init= data-full-screen=false]
            div.card-header
              div.card-title "C09-SIDE"
            div.card-body.html-fill-container.html-fill-item
              div.cell-output-display.html-fill-container.html-fill-item
                img.img-fluid.quarto-dashboard-img-contain
            bslib-tooltip
              span.badge.bslib-full-screen-enter.rounded-pill
