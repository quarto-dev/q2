body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "Intermediate matplotlib output shown in dashboard (#11150)"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
      div.bslib-card.card.cell.html-fill-container [data-bslib-card-init= data-full-screen=false]
        div.card-header
          div.card-title "plot with a title"
        div.card-body.html-fill-container.html-fill-item
          div.code-copy-outer-scaffold.html-fill-container.html-fill-item
            div#cb1.cell-code.html-fill-container.html-fill-item.sourceCode
          div.cell-output.cell-output-display.html-fill-container.html-fill-item
            img.quarto-dashboard-img-contain
        bslib-tooltip
          span.badge.bslib-full-screen-enter.rounded-pill
      div.bslib-card.card.cell.html-fill-container [data-bslib-card-init= data-full-screen=false]
        div.card-header
          div.card-title "table and graph in one card"
        div.card-body.html-fill-container.html-fill-item
          div#3ca4abdd.cell.html-fill-container.html-fill-item.quarto-layout-panel [title=table and graph in one card]
            div.html-fill-container.html-fill-item.quarto-layout-row
              div.html-fill-container.html-fill-item
              div.html-fill-container.html-fill-item.quarto-layout-cell [style=flex-basis: 50.0%;justify-content: flex-start;]
                div.html-fill-container.html-fill-item [style=height:525px; width:100%;]
                  div#<uuid>.html-fill-container.html-fill-item.plotly-graph-div [style=height:100%; width:100%;]
        bslib-tooltip
          span.badge.bslib-full-screen-enter.rounded-pill
      div#<uuid>.hidden
