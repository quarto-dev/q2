body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "ValueBoxes"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr) minmax(3em, 1fr) minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
      div.bslib-card.bslib-value-box.card.html-fill-container.valuebox [data-bslib-card-init= style=background: #00009933; color: #ffffff;]
        div.card-body.html-fill-container.html-fill-item
          div.html-fill-container.html-fill-item.value-box-grid
            div.value-box-area
              p.value-box-title ""
              p.value-box-value "56"
      div.bg-warning.bslib-card.bslib-value-box.card.html-fill-container.valuebox [data-bslib-card-init=]
        div.card-body.html-fill-container.html-fill-item
          div.html-fill-container.html-fill-item.value-box-grid
            div.value-box-area
              p.value-box-title "Number of things"
              p.value-box-value "56"
      div.bslib-card.bslib-value-box.card.html-fill-container.text-green.valuebox [data-bslib-card-init=]
        div.card-body.html-fill-container.html-fill-item
          div.html-fill-container.html-fill-item.value-box-grid
            div.value-box-area
              p.value-box-title "Number of things"
              p.value-box-value "56"
      div.bg-secondary.bslib-card.bslib-value-box.card.html-fill-container.valuebox [data-bslib-card-init=]
        div.card-body.html-fill-container.html-fill-item
          div.html-fill-container.html-fill-item.value-box-grid
            div.value-box-area
              p.value-box-title "What up trey"
              p.value-box-value "56"
