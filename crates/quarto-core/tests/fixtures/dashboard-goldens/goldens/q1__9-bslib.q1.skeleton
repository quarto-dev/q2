body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "Yo"
            div.navbar-author "MTV Raps"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, max-content); grid-auto-columns: minmax(0, 1fr);]
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bg-pink.bslib-card.bslib-mb-spacing.bslib-value-box.card.html-fill-container.html-fill-item.showcase-left-center [data-bslib-card-init= data-full-screen=false]
          div.bslib-gap-spacing.card-body.html-fill-container.html-fill-item [style=margin-top:auto;margin-bottom:auto;flex:1 1 auto; padding:0;]
            div.html-fill-item.value-box-grid [style=--bslib-grid-height:auto;--bslib-grid-height-mobile:auto;---bslib-value-box-showcase-w:30%;---bslib-value-box-showcase-w-fs:1fr;---bslib-value-box-showcase-max-h:100px;---bslib-value-box-showcase-max-h-fs:67%;]
              div.html-fill-container.html-fill-item.value-box-showcase
              div.html-fill-container.html-fill-item.value-box-area
                p.value-box-title "1st value"
                p.value-box-value "789"
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
        div.bg-blue.bslib-card.bslib-mb-spacing.bslib-value-box.card.html-fill-container.html-fill-item.showcase-left-center [data-bslib-card-init= data-full-screen=false]
          div.bslib-gap-spacing.card-body.html-fill-container.html-fill-item [style=margin-top:auto;margin-bottom:auto;flex:1 1 auto; padding:0;]
            div.html-fill-item.value-box-grid [style=--bslib-grid-height:auto;--bslib-grid-height-mobile:auto;---bslib-value-box-showcase-w:30%;---bslib-value-box-showcase-w-fs:1fr;---bslib-value-box-showcase-max-h:100px;---bslib-value-box-showcase-max-h-fs:67%;]
              div.html-fill-container.html-fill-item.value-box-showcase
              div.html-fill-container.html-fill-item.value-box-area
                p.value-box-title "2nd value"
                p.value-box-value "789"
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
        div.bg-green.bslib-card.bslib-mb-spacing.bslib-value-box.card.html-fill-container.html-fill-item.showcase-left-center [data-bslib-card-init= data-full-screen=false]
          div.bslib-gap-spacing.card-body.html-fill-container.html-fill-item [style=margin-top:auto;margin-bottom:auto;flex:1 1 auto; padding:0;]
            div.html-fill-item.value-box-grid [style=--bslib-grid-height:auto;--bslib-grid-height-mobile:auto;---bslib-value-box-showcase-w:30%;---bslib-value-box-showcase-w-fs:1fr;---bslib-value-box-showcase-max-h:100px;---bslib-value-box-showcase-max-h-fs:67%;]
              div.html-fill-container.html-fill-item.value-box-showcase
              div.html-fill-container.html-fill-item.value-box-area
                p.value-box-title "3rd value"
                p.value-box-value "789"
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
