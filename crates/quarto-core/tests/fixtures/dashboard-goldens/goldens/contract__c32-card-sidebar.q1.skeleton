body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "C32 Card Sidebar"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
      div.bslib-grid [style=display: grid; grid-template-columns: minmax(3em, 1fr) minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
        div.bslib-card.card.cell.html-fill-container [data-bslib-card-init= data-full-screen=false]
          div.card-header
            div.card-title "C32-TARGET-NEXT"
          div.bslib-sidebar-layout.html-fill-container.html-fill-item [data-bslib-sidebar-init=true data-bslib-sidebar-open=desktop style=--bslib-sidebar-width: 150px]
            div.html-fill-container.html-fill-item.main
              div.card-body.html-fill-container.html-fill-item
                div.cell-output-display.html-fill-container.html-fill-item
                  img.img-fluid.quarto-dashboard-img-contain
            aside#card-1-card-sidebar.html-fill-container.html-fill-item.sidebar
              div.card-sidebar.html-fill-container.html-fill-item
            button.collapse-toggle [aria-controls=card-1-card-sidebar title=Toggle sidebar]
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
        div.bslib-card.card.cell.html-fill-container [data-bslib-card-init= data-full-screen=false]
          div.card-header
            div.card-title "C32-TARGET-PREV"
          div.bslib-sidebar-layout.html-fill-container.html-fill-item.sidebar-right [data-bslib-sidebar-init=true data-bslib-sidebar-open=desktop]
            div.html-fill-container.html-fill-item.main
              div.card-body.html-fill-container.html-fill-item
                div.cell-output-display.html-fill-container.html-fill-item
                  img.img-fluid.quarto-dashboard-img-contain
            aside#card-2-card-sidebar.html-fill-container.html-fill-item.sidebar
              div.card-sidebar.html-fill-container.html-fill-item
            button.collapse-toggle [aria-controls=card-2-card-sidebar title=Toggle sidebar]
          bslib-tooltip
            span.badge.bslib-full-screen-enter.rounded-pill
        div#<uuid>.hidden
