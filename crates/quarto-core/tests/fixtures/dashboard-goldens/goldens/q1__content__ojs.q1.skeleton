body.dashboard-fill.dashboard-sidebar.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "Observable"
            div.navbar-subtitle "Inputs and Other Stuff"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.dashboard-sidebar-container.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid-item.cell.hidden.html-fill-item
      div#cb1.cell-code.hidden.sourceCode
      div.cell-output.cell-output-display.hidden
    div.bslib-sidebar-layout.html-fill-container.html-fill-item [data-bslib-sidebar-border=false data-bslib-sidebar-border-radius=false data-bslib-sidebar-init=true data-bslib-sidebar-open=desktop]
      div.html-fill-container.html-fill-item.main
        div.html-fill-container.html-fill-item.sidebar-content
          div.bslib-grid.html-fill-container.html-fill-item [style=display: grid; grid-template-columns: minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
            div.bslib-grid.html-fill-container.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
              div.cell.hidden.html-fill-container.html-fill-item
                div.code-copy-outer-scaffold.html-fill-container.html-fill-item
                  div#cb3.cell-code.hidden.html-fill-container.html-fill-item.sourceCode
                div.cell-output.cell-output-display.hidden.html-fill-container.html-fill-item
                  div#ojs-cell-3.html-fill-container.html-fill-item
              div.bslib-card.card.cell.html-fill-container.html-fill-item [data-bslib-card-init= data-full-screen=false]
                div.card-body.html-fill-container.html-fill-item
                  div.code-copy-outer-scaffold.html-fill-container.html-fill-item
                    div#cb4.cell-code.hidden.html-fill-container.html-fill-item.sourceCode
                  div.cell-output.cell-output-display.html-fill-container.html-fill-item
                    div#ojs-cell-4.html-fill-container.html-fill-item
                bslib-tooltip
                  span.badge.bslib-full-screen-enter.rounded-pill
              div#<uuid>.hidden.html-fill-container.html-fill-item
      aside#bslib-sidebar-1.html-fill-container.html-fill-item.sidebar
        div.html-fill-container.html-fill-item
          div#cb2.cell-code.hidden.sourceCode
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
          div.cell-output.cell-output-display
      button.collapse-toggle [aria-controls=bslib-sidebar-1 title=Toggle sidebar]
