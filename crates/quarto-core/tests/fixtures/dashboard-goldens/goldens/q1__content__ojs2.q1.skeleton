body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.hidden.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "Observable"
            div.navbar-subtitle "Inputs and Other Stuff"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content [role=main]
    div.bslib-grid-item.cell.hidden.html-fill-item
      div#cb1.cell-code.hidden.sourceCode
      div.cell-output.cell-output-display.hidden
    div.bslib-grid-item.cell.hidden.html-fill-item
      div#cb2.cell-code.hidden.sourceCode
      div.cell-output.cell-output-display.hidden
    div.bslib-grid.bslib-grid-item.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
      div.bslib-card.card.html-fill-container [data-bslib-card-init= data-full-screen=false]
        div.card-body.cell.html-fill-container.html-fill-item
          div.code-copy-outer-scaffold.html-fill-container.html-fill-item
            div#cb3.cell-code.hidden.html-fill-container.html-fill-item.sourceCode
          div.cell-output.cell-output-display.html-fill-container.html-fill-item
            div#ojs-cell-3.html-fill-container.html-fill-item
        div.card-body.flow
          div.cell.html-fill-container.html-fill-item
            div.code-copy-outer-scaffold.html-fill-container.html-fill-item
              div#cb4.cell-code.hidden.html-fill-container.html-fill-item.sourceCode
            div.cell-output.cell-output-display.html-fill-container.html-fill-item
              div.html-fill-container.html-fill-item
                div#ojs-cell-4-1.html-fill-container.html-fill-item
            div.cell-output.cell-output-display.html-fill-container.html-fill-item
              div.html-fill-container.html-fill-item
                div#ojs-cell-4-2.html-fill-container.html-fill-item
        bslib-tooltip
          span.badge.bslib-full-screen-enter.rounded-pill
      div#<uuid>.hidden
