body.dashboard-fill.fullcontent.quarto-dashboard.quarto-light
  header#quarto-dashboard-header
    nav.navbar.navbar-expand-md.slim [data-bs-theme=dark]
      div.container-fluid.navbar-container
        button.navbar-toggler [aria-controls=dashboard-collapse aria-label=Toggle navigation data-bs-target=#dashboard-collapse data-bs-toggle=collapse]
          span.navbar-toggler-icon
        div.navbar-brand-container
          div.navbar-title
            div.navbar-title-text "test"
        div#dashboard-collapse.collapse.navbar-collapse
          ul.me-auto.navbar-nav.navbar-nav-scroll [role=tablist]
            li.nav-item [role=presentation]
              a#tab-page.active.nav-link [aria-controls=page aria-selected=true data-bs-target=#page data-bs-toggle=tab data-scrolling=true href=#page role=tab]
                span.nav-link-text "Page"
  div#quarto-document-content.bslib-gap-spacing.bslib-page-fill.html-fill-container.page-layout-custom.quarto-dashboard-content.quarto-dashboard-pages [role=main]
    div.bslib-grid.bslib-grid-item.html-fill-item.tab-content [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
      div#page.active.dashboard-page.html-fill-container.html-fill-item.show.tab-pane [aria-labelledby=tab-page data-scrolling=true]
        div.bslib-grid.html-fill-container.html-fill-item [style=display: grid; grid-template-rows: minmax(3em, 1fr); grid-auto-columns: minmax(0, 1fr);]
          div.bslib-grid.html-fill-container.html-fill-item [style=display: grid; grid-template-columns: minmax(3em, 1fr); grid-auto-rows: minmax(0, 1fr);]
            div.bslib-card.card.html-fill-container.html-fill-item.tabset [data-bslib-card-init= data-full-screen=false]
              div.bslib-navs-card-title.card-header.dashboard-card-no-title
                ul.card-header-tabs.nav.nav-tabs [data-tabsetid=card-tabset-1 role=tablist]
                  li.nav-item [role=presentation]
                    a.active.nav-link [aria-selected=true data-bs-toggle=tab data-value=Tabset1 href=#card-tabset-1-1 role=tab] "Tabset1"
                  li.nav-item [role=presentation]
                    a.nav-link [aria-selected=false data-bs-toggle=tab data-value=Tabset2 href=#card-tabset-1-2 role=tab] "Tabset2"
              div#<uuid>.hidden.html-fill-container.html-fill-item
              div.html-fill-container.html-fill-item.tab-content [data-tabset-id=card-tabset-1]
                div#card-tabset-1-1.active.html-fill-container.html-fill-item.show.tab-pane [role=tabpanel]
                  div.card-body.html-fill-container.html-fill-item
                    div.cell-output.cell-output-stdout.html-fill-container.html-fill-item
                div#card-tabset-1-2.html-fill-container.html-fill-item.tab-pane [role=tabpanel]
                  div.card-body.html-fill-container.html-fill-item
                    div.cell-output.cell-output-stdout.html-fill-container.html-fill-item
              bslib-tooltip
                span.badge.bslib-full-screen-enter.rounded-pill
