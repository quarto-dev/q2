<math xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>a</mi><mo>≤</mo><mi>b</mi><mo>≥</mo><mi>c</mi><mo>≈</mo><mi>d</mi><mo>≡</mo><mi>e</mi><mo>∼</mo><mi>f</mi><mo>∝</mo><mi>g</mi><mo>∈</mo><mi>h</mi><mo>⊂</mo><mi>i</mi><mo>⊆</mo><mi>j</mi><mo>≪</mo><mi>k</mi><mo>≫</mo><mi>l</mi><mo>≃</mo><mi>m</mi><mo>≅</mo><mi>n</mi><mo>⟂</mo><mi>o</mi><mo>∥</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">a \leq b \geq c \approx d \equiv e \sim f \propto g \in h \subset i \subseteq j \ll k \gg l \simeq m \cong n \perp o \parallel p</annotation></semantics></math>
