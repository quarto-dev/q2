{
  "id": "reset-hard",
  "title": "reset --hard discards edits the doc holds",
  "steps": [
    {
      "git": [
        "init",
        "-b",
        "main"
      ]
    },
    {
      "git": [
        "config",
        "user.email",
        "t@example.com"
      ]
    },
    {
      "git": [
        "config",
        "user.name",
        "T"
      ]
    },
    {
      "git": [
        "config",
        "core.autocrlf",
        "false"
      ]
    },
    {
      "write": {
        "path": "a.qmd",
        "content": "one\n"
      }
    },
    {
      "git": [
        "add",
        "a.qmd"
      ]
    },
    {
      "git": [
        "commit",
        "-m",
        "base"
      ]
    },
    {
      "write": {
        "path": "a.qmd",
        "content": "edited\n"
      }
    },
    {
      "git": [
        "reset",
        "--hard"
      ],
      "expect": {
        "verdict": "checkout"
      }
    }
  ]
}
