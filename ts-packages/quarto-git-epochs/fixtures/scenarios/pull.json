{
  "id": "pull",
  "title": "A fast-forward pull is checkout-type",
  "steps": [
    {
      "git": [
        "init",
        "-b",
        "main"
      ]
    },
    {
      "git": [
        "config",
        "user.email",
        "t@example.com"
      ]
    },
    {
      "git": [
        "config",
        "user.name",
        "T"
      ]
    },
    {
      "git": [
        "config",
        "core.autocrlf",
        "false"
      ]
    },
    {
      "write": {
        "path": "a.qmd",
        "content": "one\n"
      }
    },
    {
      "git": [
        "add",
        "a.qmd"
      ]
    },
    {
      "git": [
        "commit",
        "-m",
        "base"
      ]
    },
    {
      "git": [
        "switch",
        "-c",
        "up"
      ]
    },
    {
      "write": {
        "path": "a.qmd",
        "content": "up\n"
      }
    },
    {
      "git": [
        "commit",
        "-am",
        "up"
      ]
    },
    {
      "git": [
        "switch",
        "main"
      ]
    },
    {
      "git": [
        "merge",
        "--ff-only",
        "up"
      ],
      "expect": {
        "verdict": "checkout"
      }
    }
  ]
}
