{
  "name": "@quarto/share-url",
  "version": "0.0.1",
  "private": true,
  "description": "Quarto Hub share URLs: build and parse project references, compare hub servers",
  "license": "MIT",
  "author": {
    "name": "Posit PBC"
  },
