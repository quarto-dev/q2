    {"name": "latex: markdown beats latex", "flags": {"toLatex": true}, "data": {"text/latex": "l", "text/markdown": "m"}, "expected": "text/markdown"},
    {"name": "latex: pdf after latex", "flags": {"toLatex": true}, "data": {"application/pdf": "p", "text/latex": "l"}, "expected": "text/latex"},
